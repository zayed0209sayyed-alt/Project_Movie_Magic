# Copy to .env and edit.
SECRET_KEY=change-me
# false = local JSON database + console e-mails (no AWS needed)
# true  = DynamoDB + SNS (needs an IAM role on EC2 or AWS credentials)
USE_AWS=false
AWS_REGION=ap-south-1
# Optional: reuse an existing SNS topic. If blank, "MovieMagicNotifications" is created.
SNS_TOPIC_ARN=
# Comma-separated list of admin e-mails
ADMIN_EMAILS=admin@moviemagic.com
